{
  "name": "rspack-chain",
  "version": "2.2.0",
  "keywords": [
    "rspack",
    "config",
    "chain",
    "api"
  ],
  "repository": "rstackjs/rspack-chain",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "typings": "types/index.d.ts",
  "files": [
    "dist",
    "types/*.d.ts"
  ],
  "scripts": {
    "build": "rs lib",
    "bump": "pnpx bumpp",
    "check": "rs check",
    "dev": "rs lib -w",
    "format": "rs fmt",
    "lint": "rs lint",
    "prepare": "rs hooks",
    "test": "rs test",
    "test:types": "tsc -p ./types/test/tsconfig.json"
  },
  "devDependencies": {
    "@rspack/core": "2.2.1",
    "deepmerge": "^4.3.1",
    "javascript-stringify": "^2.1.0",
    "rstack": "^0.7.2",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@rspack/core": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@rspack/core": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.24.0"
}
